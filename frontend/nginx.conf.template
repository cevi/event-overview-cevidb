# Rendered by docker-entrypoint.sh (envsubst on ${API_URI}) to /etc/nginx/conf.d/default.conf.
# Runs in nginx-unprivileged, hence port 8080 instead of 80.
server {
    listen 8080;
    root /usr/share/nginx/html;

    server_tokens off;

    # Security headers, applied to every response (see NFR-021).
    # - frame-ancestors instead of X-Frame-Options: embedding into Cevi sites is a feature (UC-005)
    # - style-src 'unsafe-inline': required by Angular Material
    # - connect-src: the backend the frontend was built for
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_URI}; frame-ancestors https://*.cevi.ch https://cevi.ch https://*.cevi.tools https://cevi.tools; base-uri 'self'; object-src 'none'; form-action 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = / {
        try_files /index.html =404;
    }

    location /de/ {
        rewrite ^/de/(.*)$ /de-CH/$1 last;
    }

    location /fr/ {
        rewrite ^/fr/(.*)$ /fr-CH/$1 last;
    }

    location /de-CH/ {
        try_files $uri $uri/ /de-CH/index.html;
    }

    location /fr-CH/ {
        try_files $uri $uri/ /fr-CH/index.html;
    }
}
